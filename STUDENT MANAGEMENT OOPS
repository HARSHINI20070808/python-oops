  pass
  
class student(person):
  def __init__(self,name,age,course,marks):
    self.name=name
    self.age=age
    self.course=course
    self.__marks=marks
  def show_details(self):
    print(f"My name is {self.name}\nI am {self.age} years old\nI am studying {self.course} in my university")
  def show_marks(self):
    print(f"I scored {self.__marks} in python")
  def activity(self):
    print("i am studying") 
