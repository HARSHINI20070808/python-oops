class wallet:
    def __init__(self,name,balance):
        self.name=name
        self.balance=balance
    def show_details(self):
        print(f"Account holder:{self.name}\nStarting balance:{self.balance}")
    def deposit(self,amount):
        self.balance=self.balance+amount  
        print(f"depoist:{amount}\nNew balance after deposit:{self.balance}") 
    def withdraw(self,amount):
        if amount<=self.balance:
            self.balance=self.balance-amount
            print(f"Withdrawal amount:{amount}\nNew balance after withdraw:{self.balance}")
        else:
            print("Insufficient balance")         
wallet1=wallet("Harshini",2000)

print("***DIGITAL WALLTE ICL***")
